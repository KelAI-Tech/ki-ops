# Copy to config/notify.env and fill in KI_OPS_SMTP_PASSWORD (never commit notify.env).
#
# Google Workspace (robert@kelaitech.com):
#   Google Account → Security → 2-Step Verification → App passwords → Mail → Other (ki-ops)
#   Paste the 16-character password below (no spaces).

KI_OPS_EMAIL_TRANSPORT=smtp
KI_OPS_SMTP_HOST=smtp.gmail.com
KI_OPS_SMTP_PORT=587
KI_OPS_SMTP_STARTTLS=1
KI_OPS_SMTP_USER=robert@kelaitech.com
KI_OPS_SMTP_PASSWORD=
KI_OPS_SMTP_FROM=robert@kelaitech.com
KI_OPS_EMAIL_TO=robert@kelaitech.com

# Slack Incoming Webhook — posts to one channel (invite yourself to that channel).
# Create: https://api.slack.com/apps → Create App → Incoming Webhooks → Add to workspace.
KI_OPS_SLACK_WEBHOOK_URL=
